# CLOTHZA backend — local environment (NEVER commit this file).
# Copy .env.example to .env and fill in your own values.
# Placeholders only below — never real secrets.
PORT=5000
NODE_ENV=development
MONGODB_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Session cookie for cross-domain deployments. Keep the default (lax)
# when frontend and API share one site. Set COOKIE_SAMESITE=none ONLY
# when they live on different domains — browsers then require Secure,
# which the server enables automatically (HTTPS required).
# COOKIE_SAMESITE=lax
# Razorpay TEST MODE only — never real-money keys. Secrets stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Transactional email (Step 19). Leave EMAIL_PROVIDER empty to run with
# email safely disabled (notifications are still recorded).
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=CLOTHZA <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# First-admin bootstrap (Step 16, development only). The address must
# belong to an already-registered account, then run:
#   node src/scripts/makeAdmin.js admin@example.com
# Production additionally requires ALLOW_ADMIN_BOOTSTRAP=true.
# ADMIN_EMAIL=
# ALLOW_ADMIN_BOOTSTRAP=
# Optional rate-limit tuning (requests per 15 min per IP).
# AUTH_RATE_LIMIT_MAX=200
# PAYMENT_RATE_LIMIT_MAX=200
