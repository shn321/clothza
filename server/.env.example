# CLOTHZA backend — local environment (NEVER commit this file).
# Copy .env.example to .env and fill in your own values.
# Placeholders only below — never real secrets.
#
# PRODUCTION (NODE_ENV=production) requires: MONGODB_URI, JWT_SECRET.
# CLIENT_URL should be the exact frontend origin (CORS is fail-closed).
PORT=5000
NODE_ENV=development
MONGODB_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Session cookie for cross-domain deployments. Same-site setups keep
# the default (lax). When the frontend and API live on different
# domains (e.g. Vercel frontend + Render API), browsers require
# SameSite=None with Secure — the server now defaults to None
# automatically in production when CLIENT_URL is set. Set
# COOKIE_SAMESITE explicitly only to override that default.
# COOKIE_SAMESITE=none
# Payments are DEMO ONLY (Cash on Delivery + simulated Online Payment).
# The demo flow needs NO gateway credentials. The variables below are
# optional legacy Razorpay TEST MODE settings only — leave them empty
# unless you intentionally exercise that flow in development. Never use
# real-money keys; secrets stay server-side and never reach the frontend.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Transactional email (Step 19). Leave EMAIL_PROVIDER empty to run with
# email safely disabled (notifications are still recorded).
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=CLOTHZA <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# First-admin bootstrap (Step 16, development only). The address must
# belong to an already-registered account, then run:
#   node src/scripts/makeAdmin.js admin@example.com
# Production additionally requires ALLOW_ADMIN_BOOTSTRAP=true.
# ADMIN_EMAIL=
# ALLOW_ADMIN_BOOTSTRAP=
# Optional rate-limit tuning (requests per 15 min per IP).
# AUTH_RATE_LIMIT_MAX=200
# PAYMENT_RATE_LIMIT_MAX=200
# CMS image storage (Content Management). CMS image uploads and the
# Media Library work WITHOUT these (plain image URLs are stored).
# To enable server-side uploads to Cloudinary, create a free account at
# https://cloudinary.com, open Dashboard, and fill in:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# The secret stays backend-only and is never sent to the frontend.
